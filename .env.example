# Backend
MCPHARBOR_ENV=development
MCPHARBOR_LOG_LEVEL=info
MCPHARBOR_API_HOST=127.0.0.1
MCPHARBOR_API_PORT=8741

# PostgreSQL (dev via docker compose — desktop app uses SQLite automatically)
DATABASE_URL=postgresql+asyncpg://mcpharbour:mcpharbour@localhost:5432/mcpharbour
POSTGRES_USER=mcpharbour
POSTGRES_PASSWORD=mcpharbour
POSTGRES_DB=mcpharbour
POSTGRES_PORT=5432

# Docker (MCP runtime)
# macOS Docker Desktop: leave unset or use unix:///Users/YOU/.docker/run/docker.sock
# DOCKER_HOST=unix:///var/run/docker.sock

# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8741
VITE_APP_NAME=MCP Harbor
